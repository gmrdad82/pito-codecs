#!/usr/bin/env bash
set -euo pipefail

target=${1:?usage: fuzz/seeds <target>}
dir="fuzz/corpus/$target"
mkdir -p "$dir"

hex() { printf '%b' "$(sed 's/../\\x&/g' <<<"$1")"; }

size() { printf '01%014x' "$1"; }

webm_

cluster() {
  local head=$1 times=$2 once="" body="e78100" b i
  shift 2
  for b in "$@"; do
    once+="a3$(size $((${#b} / 2)))$b"
  done
  for ((i = 0; i < times; i++)); do
    body+=$once
  done
  hex "${head}1f43b675$(size $((${#body} / 2)))$body"
}

regressions() {
  case "$1" in
    h264) hex "" > "$dir/crop-offsets.h264" ;;
    mp4) hex "" > "$dir/empty-run.mp4" ;;
    mkv)
      cluster "$webm_head" 600 "81000082ff$(printf '00%.0s' $(seq 255))" > "$dir/xiph-empty.webm"
      cluster "$webm_head" 1 "81000084fe07" "8100018009" > "$dir/fixed-lacing.webm"
      {
        hex "$webm_head"
        printf '\x1f\x43\xb6\x75\x81\x00%.0s' $(seq 12000)
        printf '\x1f\x43\xb6\x75\x84\xe7\x81\x00\xff%.0s' $(seq 8000)
      } > "$dir/near-miss.webm"
      ;;
  esac
}

case "$target" in
  probe)
    regressions mp4
    regressions mkv
    ;;
  *) regressions "$target" ;;
esac

pcod=${PCOD:-target/release/pcod}
if [ ! -x "$pcod" ]; then
  echo "fuzz/seeds: no $pcod (cargo build --release --bin pcod), only the regression inputs in $dir" >&2
  exit 0
fi

synth() {
  local name=$1
  shift
  "$pcod" synth "$dir/$name" --size 128x96 --fps 12 --duration 0.5 "$@" --force > /dev/null ||
    echo "fuzz/seeds: skipped $name" >&2
}

convert() {
  "$pcod" "$1" "$dir/$2" --force --no-progress > /dev/null || echo "fuzz/seeds: skipped $2" >&2
}

flat() {
  local f
  for f in "$@"; do
    [ -f "$f" ] && cp "$f" "$dir/$(dirname "${f#tests/refs/}" | tr / -)-$(basename "$f")"
  done
  return 0
}

chunk_table() {
  [ -s "$1" ] || return 1
  local d s c e t n m copies="" i
  d=$(od -An -v -tx1 "$1" | tr -d ' \n')
  offset() {
    awk -v h="$d" -v k="$(printf %s "$1" | od -An -tx1 | tr -d ' \n')" 'BEGIN {
      o = 0
      while ((i = index(substr(h, o + 1), k)) > 0) {
        p = o + i - 1
        if (p % 2 == 0) { print p / 2; exit }
        o = p + 1
      }
      exit 1
    }'
  }
  be() { echo $((16#${d:$(($1 * 2)):8})); }
  put() { d=${d:0:$(($1 * 2))}$2${d:$(($1 * 2 + ${#2}))}; }
  s=$(offset stsz) || return 1
  put $((s + 8)) 00000001ffffffff
  c=$(offset stsc) || return 1
  for ((e = 0; e < $(be $((c + 8))); e++)); do
    put $((c + 16 + e * 12)) ffffffff
  done
  t=$(offset trak) || return 1
  t=$((t - 4))
  n=$(be "$t")
  for ((i = 0; i < 8; i++)); do
    copies+=${d:$((t * 2)):$((n * 2))}
  done
  d=${d:0:$((t * 2))}$copies${d:$((t * 2))}
  m=$(offset moov) || return 1
  m=$((m - 4))
  put "$m" "$(printf '%08x' $(($(be "$m") + 8 * n)))"
  hex "$d" > "$2"
}

mp4_seeds() {
  synth h264-aac.mp4 --audio sine:440
  synth h264-two-tracks.mov --audio sine:440,silence
  chunk_table "$dir/h264-aac.mp4" "$dir/chunk-table.mp4" || echo "fuzz/seeds: skipped chunk-table.mp4" >&2
  flat tests/refs/mp4/*.mp4 tests/refs/mp4/*.mov tests/refs/mp4/*.m4a tests/refs/media/*.mp4 \
    tests/refs/join/*.mp4 tests/refs/pcod/*.mp4 tests/refs/pcod/*.m4a
}

mkv_seeds() {
  synth h264-aac.mkv --audio sine:440
  synth vp9-opus.webm --audio sine:440
  flat tests/refs/mkv/*.mkv tests/refs/mkv/*.webm tests/refs/media/*.mkv tests/refs/media/*.webm \
    tests/refs/pcod/*.webm
}

case "$target" in
  mp4)
    mp4_seeds
    ;;
  mkv)
    mkv_seeds
    ;;
  probe)
    mp4_seeds
    mkv_seeds
    ;;
  h264)
    flat tests/refs/h264/*.264 tests/refs/h264/*.h264
    ;;
  hevc)
    flat tests/refs/hevc/*.hevc tests/refs/hevc/*.265
    ;;
  vp9_ivf)
    flat tests/refs/mkv/*.ivf tests/refs/vp9/*.ivf
    ;;
  aac_adts)
    flat tests/refs/mp4/*.aac tests/refs/aac/*.aac
    ;;
  opus)
    synth tone.mp4 --audio sine:440
    convert "$dir/tone.mp4" stereo.opus
    rm -f "$dir/tone.mp4"
    flat tests/refs/opus/*.opus
    ;;
  pcm)
    synth tone.mp4 --audio sine:440
    convert "$dir/tone.mp4" raw.s16
    if [ -s "$dir/raw.s16" ]; then
      { printf '\x11\x02\x80\x0f\x00\x00'; cat "$dir/raw.s16"; } > "$dir/s16le-stereo.pcm"
      { printf '\x2b\x01\xa0\x0f\x00\x00'; cat "$dir/raw.s16"; } > "$dir/f32be-mono.pcm"
    fi
    rm -f "$dir/raw.s16" "$dir/tone.mp4"
    ;;
  *)
    echo "fuzz/seeds: unknown target $target" >&2
    exit 2
    ;;
esac

ls -l "$dir"
