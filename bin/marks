#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
assets="${PITO_ASSETS:?PITO_ASSETS names the checkout of the PITO MD brand masters}"
rev=aa3aee8b232a1b848995bf3d9a012a01d4aff8ec
mkdir -p assets/marks
git -C "$assets" show "$rev:exports/pitomd/readme/wordmark.svg" > assets/marks/pitomd-wordmark.svg
