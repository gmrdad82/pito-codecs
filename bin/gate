#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

fast=0
case "${1:-}" in
    --fast) fast=1 ;;
    "") ;;
    *)
        echo "usage: bin/gate [--fast]" >&2
        exit 2
        ;;
esac

partition=()
shards="${DISPATCH_SHARDS:-}"
if [ -n "$shards" ]; then
    shard="${DISPATCH_SHARD:-}"
    case "$shards$shard" in
        *[!0-9]*) shards=0 ;;
    esac
    if [ "$shards" = 0 ] || [ -z "$shard" ] || [ "$((10#$shards))" -lt 1 ] || [ "$((10#$shard))" -lt 1 ] || [ "$((10#$shard))" -gt "$((10#$shards))" ]; then
        echo "gate: DISPATCH_SHARD=${DISPATCH_SHARD:-} of DISPATCH_SHARDS=${DISPATCH_SHARDS} is not a shard" >&2
        exit 2
    fi
    if [ "$((10#$shards))" -gt 1 ]; then
        partition=(--partition "count:$((10#$shard))/$((10#$shards))")
    fi
fi

sysroot="$(rustc --print sysroot)"
cargo fmt --all --check
cargo clippy --all-targets -- -D warnings
cargo clippy --lib --no-default-features --features audio,mp3,opus,ac3 -- -D warnings
for target in x86_64-pc-windows-gnu aarch64-apple-darwin aarch64-unknown-linux-gnu; do
    if [ -d "$sysroot/lib/rustlib/$target/lib" ]; then
        cargo clippy --all-targets --target "$target" -- -D warnings
    else
        echo "gate: skipping clippy for $target (its std is not installed)"
    fi
done
stubs="$PWD/tmp/gate-stubs"
mkdir -p "$stubs"
for tool in ff''mpeg ff''probe; do
    printf '#!/bin/sh\necho "%s was spawned by a test" >&2\nexit 1\n' "$tool" >"$stubs/$tool"
    chmod +x "$stubs/$tool"
done
tests=(env "PATH=$stubs:$PATH" cargo nextest run --cargo-profile ci --all-targets --no-fail-fast)
if [ "${#partition[@]}" -gt 0 ]; then
    tests+=("${partition[@]}")
fi
if command -v prlimit >/dev/null 2>&1; then
    prlimit --core=1:1 -- "${tests[@]}"
else
    "${tests[@]}"
fi
if [ "$fast" -eq 0 ]; then
    cargo build --release
fi
echo "gate ok"
